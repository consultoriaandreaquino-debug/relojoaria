# Copie este arquivo para .env e ajuste os valores do seu ambiente.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=relojoaria
DB_USER=root
DB_PASS=

# Endereço público da aplicação, sem barra no final.
APP_URL=http://localhost/relojoaria

# true mostra detalhes de erro (só em desenvolvimento).
APP_DEBUG=false
